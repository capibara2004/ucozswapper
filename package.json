{
  "name": "ucoz-market-page-ai",
  "private": true,
  "version": "0.1.0",
  "description": "AI marketplace product landing generator for uCoz",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "deploy:ucoz": "npm run build && node scripts/prepare-ucoz-deploy.mjs",
    "start": "npm --prefix server run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
