PORT=3001
DEMO_FALLBACK=true
NODE_ENV=development

# Required integrations — backend only, never expose these values to the client.
ZENROWS_API_KEY=
NEXUS_API_KEY=

# Optional integration settings (the values below are application defaults).
NEXUS_API_BASE_URL=https://api.nexus-hub.tech/v1
NEXUS_MODEL=gemini-3.8-flash
LANDING_TEMPLATE_MODE=bento-dark
AI_DEMO_FALLBACK=false
ZENROWS_CAPTURE_XHR=false
ZENROWS_EMPTY_RETRY=true

# Optional: configured demo-site publication.
UCOZ_SITE_URL=
UCOZ_PUBLISH_MODE=ftp
UCOZ_FTP_HOST=
UCOZ_FTP_USER=
UCOZ_FTP_PASS=

# Required only when UCOZ_PUBLISH_MODE=pages.
UCOZ_API_TOKEN=
SCRAPFLY_API_KEY=
AVITO_SCRAPER=scrapfly
